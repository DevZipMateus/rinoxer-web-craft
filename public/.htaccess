# ============================================================
#  Rinoxer — Apache .htaccess
#  Domínio: https://www.rinoxer.com.br
# ============================================================

# ------------------------------------------------------------
# 1. REWRITE ENGINE — habilita mod_rewrite
# ------------------------------------------------------------
Options -MultiViews
RewriteEngine On
RewriteBase /

# ------------------------------------------------------------
# 2. HTTPS — redireciona HTTP → HTTPS
# ------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------
# 3. WWW — força www (canonical)
# ------------------------------------------------------------
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------
# 4. SPA FALLBACK — React Router (client-side routing)
#    Arquivos e diretórios físicos são servidos normalmente;
#    tudo o mais cai no index.html para o React tratar.
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ------------------------------------------------------------
# 5. GTM PREVIEW MODE — permissões de CSP e CORS
#    Permite que o GTM Debugger/Preview se comunique com o site
#    sem ser bloqueado por políticas de segurança.
# ------------------------------------------------------------

# Desativa qualquer X-Frame-Options restritivo para o GTM Preview
# (o GTM Preview abre o site em um iframe interno)
<IfModule mod_headers.c>
    # Exclui arquivos estáticos (xml, txt) das restrições de CSP e X-Frame
    <FilesMatch "\.(xml|txt)$">
        Header unset Content-Security-Policy
        Header unset X-Frame-Options
    </FilesMatch>

    # Remove qualquer DENY/SAMEORIGIN herdado do servidor
    Header always unset X-Frame-Options

    # Permite o iframe apenas do domínio do GTM
    Header always set X-Frame-Options "ALLOW-FROM https://tagmanager.google.com"

    # Content-Security-Policy — libera recursos necessários para GTM + GA4
    Header always set Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' 'unsafe-inline' 'unsafe-eval' \
            https://www.googletagmanager.com \
            https://www.google-analytics.com \
            https://ssl.google-analytics.com \
            https://tagmanager.google.com \
            https://www.googleadservices.com \
            https://googleads.g.doubleclick.net; \
        img-src 'self' data: \
            https://www.google-analytics.com \
            https://www.googletagmanager.com \
            https://ssl.gstatic.com \
            https://www.gstatic.com \
            https://googleads.g.doubleclick.net; \
        connect-src 'self' \
            https://www.google-analytics.com \
            https://analytics.google.com \
            https://stats.g.doubleclick.net \
            https://region1.google-analytics.com \
            https://www.googletagmanager.com; \
        frame-src \
            https://tagmanager.google.com \
            https://www.googletagmanager.com \
            https://bid.g.doubleclick.net; \
        font-src 'self' data: https://fonts.gstatic.com; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://tagmanager.google.com; \
    "

    # Cabeçalhos de segurança adicionais
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------
# 6. CACHE — performance para assets estáticos
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — sem cache (SPA precisa sempre do index.html atualizado)
    ExpiresByType text/html                 "access plus 0 seconds"

    # JS / CSS
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/css                  "access plus 1 year"

    # Imagens
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    # Fontes
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"

    # Vídeo
    ExpiresByType video/mp4                 "access plus 1 month"
</IfModule>

# ------------------------------------------------------------
# 7. GZIP — compressão de texto
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------
# 8. SEGURANÇA — bloqueia acesso a arquivos sensíveis
# ------------------------------------------------------------
<FilesMatch "(^\.htaccess|^\.env|package\.json|tsconfig\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>
